# =============================================================================
#  Jacuzzi Tracker — environment variables
# =============================================================================
# These are the 6 values the app needs. You will paste them into VERCEL's
# "Environment Variables" screen (Settings -> Environment Variables) — you do
# NOT need to create a real .env file yourself unless you want to run the app
# on your own computer. Never commit real values to git.
#
# See README.md for the full click-by-click walkthrough of where each value
# comes from.
# -----------------------------------------------------------------------------

# 1. A password you invent. You type this once to unlock the app on your phone.
#    Make it a proper phrase, not a 4-digit PIN. Example: correct-horse-battery-42
APP_PASSCODE=change-me-to-a-long-random-phrase

# 2. A long random string you invent. The app uses it internally so ONLY the
#    daily scheduler can trigger reminders. Just mash the keyboard. You never
#    type this anywhere except once into Vercel.
CRON_SECRET=change-me-to-another-long-random-string

# 3 & 4. Come from your Supabase project:
#    Supabase dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-starts-with-eyJ...

# 5. A private "channel name" you invent for phone notifications. Treat it like
#    a password — anyone who knows it could send you notifications. Example:
#    hottub-a7f3k9q2z. You subscribe to this exact name in the free ntfy app.
NTFY_TOPIC=hottub-change-me-to-something-random

# 6. A long random string you invent. It protects your private calendar-feed
#    link so only you can subscribe to it. Just mash the keyboard again.
ICS_FEED_TOKEN=change-me-to-another-long-random-string
